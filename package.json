{
  "name": "midestic-rn-library",
  "version": "0.1.0",
  "description": "CLI for adding individual, editable NativeWind React Native components to your app.",
  "keywords": [
    "react-native",
    "components",
    "ui",
    "nativewind",
    "tailwind",
    "storybook",
    "library",
    "cli",
    "shadcn",
    "icons",
    "svg"
  ],
  "license": "MIT",
  "main": "./src/index.ts",
  "source": "./src/index.ts",
  "react-native": "./src/index.ts",
  "bin": {
    "midestic-rn-library": "bin/cli.cjs"
  },
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tailwind-preset": "./tailwind/preset.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "tailwind",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest && node --test test/cli.test.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example": "npm run start --prefix example",
    "storybook": "npm run storybook --prefix example",
    "docs:start": "npm run start --prefix docs",
    "docs:build": "npm run build --prefix docs",
    "prepack": "npm run typecheck && npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4"
  },
  "peerDependencies": {
    "nativewind": ">=4.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=4.0.0",
    "react-native-svg": ">=13.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "nativewind": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "^0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.1",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "nativewind": "^4.2.7",
    "prettier": "^3.9.9",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-reanimated": "^4.7.0",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-svg": "^15.15.5",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.17",
    "test-renderer": "^1.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
